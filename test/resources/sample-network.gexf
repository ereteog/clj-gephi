    <graph mode="static" defaultedgetype="undirected">
        <nodes>
            <node id="alice" label="Alice" />
            <node id="bob" label="Bob" />
            <node id="charlie" label="Charlie" />
            <node id="diana" label="Diana" />
            <node id="eve" label="Eve" />
        </nodes>
        <edges>
            <edge id="0" source="alice" target="bob" />
            <edge id="1" source="alice" target="charlie" />
            <edge id="2" source="bob" target="charlie" />
            <edge id="3" source="bob" target="diana" />
            <edge id="4" source="charlie" target="diana" />
